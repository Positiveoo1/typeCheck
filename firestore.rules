rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isValidResult() {
      return hasOnlyFields([
          'accuracy',
          'correctChars',
          'createdAt',
          'elapsedSeconds',
          'endedByAccuracyLock',
          'modeLabel',
          'netWpm',
          'rawWpm',
          'testType',
          'trainingMode',
          'wpm',
          'wrongChars'
        ]) &&
        isValidNumber(request.resource.data.accuracy, 0, 100) &&
        isValidNumber(request.resource.data.correctChars, 0, 20000) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.elapsedSeconds is number &&
        request.resource.data.elapsedSeconds >= 0 &&
        request.resource.data.endedByAccuracyLock is bool &&
        request.resource.data.modeLabel is string &&
        request.resource.data.modeLabel.size() > 0 &&
        request.resource.data.modeLabel.size() <= 80 &&
        request.resource.data.testType in ['time', 'words'] &&
        request.resource.data.trainingMode is string &&
        request.resource.data.trainingMode.size() > 0 &&
        request.resource.data.trainingMode.size() <= 40 &&
        (!('netWpm' in request.resource.data) ||
          isValidNumber(request.resource.data.netWpm, 0, 400)) &&
        (!('rawWpm' in request.resource.data) ||
          isValidNumber(request.resource.data.rawWpm, 0, 400)) &&
        isValidNumber(request.resource.data.wpm, 0, 400) &&
        isValidNumber(request.resource.data.wrongChars, 0, 20000);
    }

    // --- Leaderboard integrity (direct, Spark-plan path) -------------------
    // Clients write leaderboard entries themselves, so these rules bound
    // what they can claim. The opt-in verified path (functions/index.js,
    // submitResult) writes with the Admin SDK and bypasses these rules; it
    // is the only writer allowed to set `verified: true`.

    function isNotVerifiedClaim() {
      return !('verified' in request.resource.data) ||
        request.resource.data.verified == false;
    }

    // Per-user rate limit: every leaderboard write must also stamp
    // users/{uid}.lastLeaderboardSubmitAt = request.time in the same batch,
    // and the previous stamp must be at least 5 seconds old.
    function hasFreshLeaderboardStamp() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return existsAfter(userPath) &&
        getAfter(userPath).data.lastLeaderboardSubmitAt == request.time &&
        (!exists(userPath) ||
          !('lastLeaderboardSubmitAt' in get(userPath).data) ||
          request.time >= get(userPath).data.lastLeaderboardSubmitAt + duration.value(5, 's'));
    }

    // users/{uid}.lastLeaderboardSubmitAt may only move to "now", so it
    // can't be back-dated (or removed) to dodge the rate limit.
    function isValidLeaderboardStampChange() {
      let hadStamp = resource != null && ('lastLeaderboardSubmitAt' in resource.data);
      let hasStamp = 'lastLeaderboardSubmitAt' in request.resource.data;
      return (!hadStamp &&
          (!hasStamp || request.resource.data.lastLeaderboardSubmitAt == request.time)) ||
        (hadStamp && hasStamp &&
          (request.resource.data.lastLeaderboardSubmitAt == resource.data.lastLeaderboardSubmitAt ||
            request.resource.data.lastLeaderboardSubmitAt == request.time));
    }

    function isPlausibleLeaderboardScore(data) {
      return isValidNumber(data.wpm, 0, 300) &&
        isValidNumber(data.accuracy, 50, 100) &&
        data.elapsedSeconds is number &&
        data.elapsedSeconds >= 5;
    }

    // elapsedSeconds/testValue must agree with testType and the mode label:
    // timed runs last at most their length (accuracy lock can end them
    // early); word runs are bounded by ~200 wpm-seconds per word, which no
    // human beats (e.g. 60 words can't be finished at 300 wpm in 5s).
    function hasConsistentDuration(data) {
      return data.testValue is int &&
        ((data.testType == 'time' &&
          data.testValue >= 5 && data.testValue <= 300 &&
          data.elapsedSeconds <= data.testValue + 1 &&
          data.modeLabel.matches('^(.+ )?' + string(data.testValue) + 's$')) ||
        (data.testType == 'words' &&
          data.testValue in [10, 30, 60] &&
          data.elapsedSeconds <= 3600 &&
          data.wpm * data.elapsedSeconds <= data.testValue * 200 &&
          data.modeLabel.matches('^(.+ )?' + string(data.testValue) + ' words$')));
    }

    function isValidLeaderboardResult() {
      let data = request.resource.data;
      return hasOnlyFields([
          'accuracy',
          'createdAt',
          'elapsedSeconds',
          'modeLabel',
          'testType',
          'testValue',
          'trainingMode',
          'userId',
          'verified',
          'wpm'
        ]) &&
        data.userId == request.auth.uid &&
        isNotVerifiedClaim() &&
        data.createdAt == request.time &&
        data.modeLabel is string &&
        data.modeLabel.size() > 0 &&
        data.modeLabel.size() <= 80 &&
        data.testType in ['time', 'words'] &&
        data.trainingMode is string &&
        data.trainingMode.size() > 0 &&
        data.trainingMode.size() <= 40 &&
        !(data.trainingMode in ['custom', 'daily']) &&
        isPlausibleLeaderboardScore(data) &&
        hasConsistentDuration(data);
    }

    // --- Daily challenge ------------------------------------------------
    // dateKey is the UTC day (YYYY-MM-DD); writes are accepted during that
    // day plus a 10 minute grace period for runs finishing after midnight.
    function isCurrentDailyKey(dateKey) {
      return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.time >= timestamp.date(
          int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])) &&
        request.time < timestamp.date(
          int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10])) +
          duration.value(1450, 'm');
    }

    // A daily run is always 40 words: same bounds as other leaderboard
    // entries, with wpm * elapsedSeconds capped at 40 * 200.
    function isValidDailyEntry(userId) {
      let data = request.resource.data;
      return hasOnlyFields([
          'accuracy',
          'attempts',
          'createdAt',
          'elapsedSeconds',
          'language',
          'playerName',
          'userId',
          'verified',
          'wpm'
        ]) &&
        data.userId == userId &&
        isNotVerifiedClaim() &&
        isPlausibleLeaderboardScore(data) &&
        data.wpm * data.elapsedSeconds <= 8000 &&
        data.attempts is int &&
        data.language is string &&
        data.language.size() > 0 &&
        data.language.size() <= 20 &&
        data.playerName is string &&
        data.playerName.size() > 0 &&
        data.playerName.size() <= 80;
    }

    function isValidPublicPlayer(userId) {
      return hasOnlyFields([
        'displayName',
        'fallbackName',
        'username',
        'updatedAt'
      ]) &&
        userId == request.auth.uid &&
        (!('displayName' in request.resource.data) ||
          request.resource.data.displayName == null ||
          request.resource.data.displayName is string) &&
        request.resource.data.fallbackName is string &&
        request.resource.data.fallbackName.size() > 0 &&
        request.resource.data.fallbackName.size() <= 80 &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 32 &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidLeaderboardStampChange();
      // Deleting the profile doc would also reset the leaderboard rate limit.
      allow delete: if false;

      match /stats/dashboard {
        allow read, write: if isOwner(userId);
      }

      match /results/{resultId} {
        allow read: if isOwner(userId);
        // No Cloud Functions on the Spark plan, so results are written
        // directly by the client and validated here instead of by an
        // Admin SDK function. Revisit isValidResult() if the client
        // payload shape changes.
        allow create: if isOwner(userId) && isValidResult();
        allow update, delete: if false;
      }
    }

    match /publicPlayers/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicPlayer(userId);
      allow delete: if false;
    }

    match /leaderboardResults/{resultId} {
      allow read: if true;
      // Direct client writes (default, Spark plan): shape, plausibility
      // bounds and a per-user rate limit are enforced here, but the stats
      // are still self-reported. Entries written by the verified Cloud
      // Function carry `verified: true`. To accept ONLY verified entries,
      // replace the next line with `allow create: if false;` (see README,
      // "Leaderboard integrity").
      allow create: if isSignedIn() &&
        isValidLeaderboardResult() &&
        hasFreshLeaderboardStamp();
      allow update, delete: if false;
    }

    // Best daily-challenge run per user: dailyLeaderboard/{dateKey}/entries/{uid}.
    // Updates must bump `attempts` by one and either change nothing else or
    // replace the run with a faster one. Rate-limited like leaderboardResults.
    match /dailyLeaderboard/{dateKey}/entries/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        isCurrentDailyKey(dateKey) &&
        isValidDailyEntry(userId) &&
        request.resource.data.attempts == 1 &&
        request.resource.data.createdAt == request.time &&
        hasFreshLeaderboardStamp();
      allow update: if isOwner(userId) &&
        isCurrentDailyKey(dateKey) &&
        request.resource.data.attempts == resource.data.attempts + 1 &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts']) ||
          (isValidDailyEntry(userId) &&
            request.resource.data.wpm > resource.data.wpm &&
            request.resource.data.createdAt == request.time)) &&
        hasFreshLeaderboardStamp();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}