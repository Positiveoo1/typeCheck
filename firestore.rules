rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isValidPublicPlayer(userId) {
      return hasOnlyFields([
        'displayName',
        'fallbackName',
        'username',
        'updatedAt'
      ]) &&
        userId == request.auth.uid &&
        (!('displayName' in request.resource.data) ||
          request.resource.data.displayName == null ||
          request.resource.data.displayName is string) &&
        request.resource.data.fallbackName is string &&
        request.resource.data.fallbackName.size() > 0 &&
        request.resource.data.fallbackName.size() <= 80 &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 32 &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /stats/dashboard {
        allow read, write: if isOwner(userId);
      }

      match /results/{resultId} {
        allow read: if isOwner(userId);
        // Writes now happen only via the submitResult Cloud Function (Admin
        // SDK), which recomputes stats from a server-validated keystroke
        // timeline. Direct client writes are no longer trusted.
        allow create, update, delete: if false;
      }
    }

    match /publicPlayers/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicPlayer(userId);
      allow delete: if false;
    }

    match /leaderboardResults/{resultId} {
      allow read: if true;
      // Writes now happen only via the submitResult Cloud Function (Admin
      // SDK), which recomputes WPM/accuracy from a server-validated
      // keystroke timeline before writing. Direct client writes are no
      // longer trusted, since a client could otherwise submit any wpm
      // value within the old range/shape checks.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}