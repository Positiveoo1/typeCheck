rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isValidResult() {
      return hasOnlyFields([
          'accuracy',
          'correctChars',
          'createdAt',
          'elapsedSeconds',
          'endedByAccuracyLock',
          'modeLabel',
          'testType',
          'trainingMode',
          'wpm',
          'wrongChars'
        ]) &&
        isValidNumber(request.resource.data.accuracy, 0, 100) &&
        isValidNumber(request.resource.data.correctChars, 0, 20000) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.elapsedSeconds is number &&
        request.resource.data.elapsedSeconds >= 0 &&
        request.resource.data.endedByAccuracyLock is bool &&
        request.resource.data.modeLabel is string &&
        request.resource.data.modeLabel.size() > 0 &&
        request.resource.data.modeLabel.size() <= 80 &&
        request.resource.data.testType in ['time', 'words'] &&
        request.resource.data.trainingMode is string &&
        request.resource.data.trainingMode.size() > 0 &&
        request.resource.data.trainingMode.size() <= 40 &&
        isValidNumber(request.resource.data.wpm, 0, 400) &&
        isValidNumber(request.resource.data.wrongChars, 0, 20000);
    }

    function isValidLeaderboardResult() {
      return hasOnlyFields([
          'accuracy',
          'createdAt',
          'modeLabel',
          'testType',
          'trainingMode',
          'userId',
          'wpm'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        isValidNumber(request.resource.data.accuracy, 0, 100) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.modeLabel is string &&
        request.resource.data.modeLabel.size() > 0 &&
        request.resource.data.modeLabel.size() <= 80 &&
        request.resource.data.testType in ['time', 'words'] &&
        request.resource.data.trainingMode is string &&
        request.resource.data.trainingMode.size() > 0 &&
        request.resource.data.trainingMode.size() <= 40 &&
        isValidNumber(request.resource.data.wpm, 0, 400);
    }

    function isValidPublicPlayer(userId) {
      return hasOnlyFields([
          'displayName',
          'fallbackName',
          'username',
          'updatedAt'
        ]) &&
        userId == request.auth.uid &&
        (!('displayName' in request.resource.data) ||
          request.resource.data.displayName == null ||
          request.resource.data.displayName is string) &&
        request.resource.data.fallbackName is string &&
        request.resource.data.fallbackName.size() > 0 &&
        request.resource.data.fallbackName.size() <= 80 &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 32 &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /stats/dashboard {
        allow read, write: if isOwner(userId);
      }

      match /results/{resultId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidResult();
        allow update, delete: if false;
      }
    }

    match /publicPlayers/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicPlayer(userId);
      allow delete: if false;
    }

    match /leaderboardResults/{resultId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidLeaderboardResult();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
